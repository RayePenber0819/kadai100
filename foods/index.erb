<head>
    <meta charset="UTF-8">
</head>
<h1>
    Foods一覧
</h1>
<form action="/foods" method="get">
    <select name="category_select">
        <option value="all" selected>全て</option>
        <option value="fruits">フルーツ</option>
        <option value="vegetables">野菜</option>
    </select>
    <input type="text" id="minprice" name="minprice" />円～
    <input type="text" id="maxprice" name="maxprice" />
    <button type="submit" id="search" name="search">検索</button>
</form>


<ul>
    <% @foods.each do |food| %>
        <li><%= food[:name] %></li>
    <% end %>
</ul>
