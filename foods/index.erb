<head>
    <meta charset="UTF-8">
</head>
<h1>
    Foods一覧
</h1>
<form action="/foods" method="get">
    <select name="category_selected">
        <option value="all" selected>全て</option>
        <option value="fruits">フルーツ</option>
        <option value="vegetables">野菜</option>
    </select>
    <select name="price_selected">
        <option value="all" selected>金額を選択</option>
        <option value="100">100</option>
        <option value="120">120</option>
        <option value="150">150</option>
    </select>
    <button type="submit" id="search" name="search">検索</button>
</form>

<ul>
    <% @foods.each do |food| %>
        <li><%= food[:name] %>-<%= food[:price] %>円</li>
    <% end %>
</ul>
